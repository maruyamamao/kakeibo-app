<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KakeiboApp.CategorySummaryPage"
             Title="カテゴリ別集計"
             BackgroundColor="#F5F9FC">

    <ScrollView>

        <VerticalStackLayout
            Padding="20,15,20,30"
            Spacing="16">

            <!-- ヘッダー -->
            <VerticalStackLayout
                Spacing="2"
                Margin="0,5,0,5">

                <Label
                    Text="カテゴリ別集計"
                    FontSize="30"
                    FontAttributes="Bold"
                    TextColor="#1F2937" />

                <Label
                    Text="カテゴリごとの支出状況を確認できます"
                    FontSize="14"
                    TextColor="#7B8794" />

            </VerticalStackLayout>


            <!-- 月切り替え -->
            <Border
                BackgroundColor="White"
                Stroke="#DDE7F0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 14"
                Padding="8">

                <Grid
                    ColumnDefinitions="50,*,50">

                    <Button
                        Text="‹"
                        FontSize="28"
                        BackgroundColor="Transparent"
                        TextColor="#7DB7E8"
                        Clicked="OnPreviousMonthClicked" />

                    <Label
                        x:Name="MonthLabel"
                        Text="2026年9月"
                        FontSize="18"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        TextColor="#334155"
                        Grid.Column="1" />

                    <Button
                        Text="›"
                        FontSize="28"
                        BackgroundColor="Transparent"
                        TextColor="#7DB7E8"
                        Clicked="OnNextMonthClicked"
                        Grid.Column="2" />

                </Grid>

            </Border>


            <!-- 支出合計 -->
            <Border
                BackgroundColor="#EAF4FF"
                Stroke="#C9DFEF"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                Padding="20">

                <VerticalStackLayout
                    Spacing="6">

                    <Label
                        Text="今月の支出合計"
                        FontSize="15"
                        FontAttributes="Bold"
                        TextColor="#5B8DB8" />

                    <Label
                        x:Name="TotalExpenseLabel"
                        Text="¥0"
                        FontSize="32"
                        FontAttributes="Bold"
                        TextColor="#5B8DB8" />

                </VerticalStackLayout>

            </Border>


            <!-- グラフ -->
            <Border
                BackgroundColor="White"
                Stroke="#DDE7F0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                Padding="20">

                <VerticalStackLayout
                    Spacing="18">

                    <Grid
                        ColumnDefinitions="*,Auto">

                        <Label
                            Text="カテゴリ別支出"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="#1F2937" />

                        <Label
                            Text="📊"
                            FontSize="20"
                            Grid.Column="1" />

                    </Grid>

                    <Label
                        Text="支出額が多いカテゴリから表示しています"
                        FontSize="13"
                        TextColor="#7B8794" />

                    <VerticalStackLayout
                        x:Name="ChartList"
                        Spacing="16" />

                </VerticalStackLayout>

            </Border>


            <!-- カテゴリ詳細 -->
            <Label
                Text="カテゴリ別詳細"
                FontSize="21"
                FontAttributes="Bold"
                TextColor="#1F2937"
                Margin="0,8,0,0" />

            <VerticalStackLayout
                x:Name="CategoryList"
                Spacing="10" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>