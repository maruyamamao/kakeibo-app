<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KakeiboApp.MainPage"
             Title="家計簿"
             BackgroundColor="#F5F9FC">

    <ScrollView>

        <VerticalStackLayout
            Padding="20,15,20,30"
            Spacing="16">

            <!-- ========================= -->
            <!-- ヘッダー -->
            <!-- ========================= -->

            <VerticalStackLayout
                Spacing="2"
                Margin="0,5,0,5">

                <Label
                    Text="家計簿"
                    FontSize="30"
                    FontAttributes="Bold"
                    TextColor="#1F2937" />

                <Label
                    Text="今月の家計状況"
                    FontSize="14"
                    TextColor="#7B8794" />

            </VerticalStackLayout>


            <!-- ========================= -->
            <!-- 月切り替え -->
            <!-- ========================= -->

            <Border
                BackgroundColor="White"
                Stroke="#DDE7F0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 14"
                Padding="8">

                <Grid
                    ColumnDefinitions="50,*,50">

                    <Button
                        Text="‹"
                        FontSize="28"
                        BackgroundColor="Transparent"
                        TextColor="#4A90E2"
                        Clicked="OnPreviousMonthClicked" />

                    <Label
                        x:Name="MonthLabel"
                        Text="2026年9月の収支"
                        FontSize="18"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        TextColor="#334155"
                        Grid.Column="1" />

                    <Button
                        Text="›"
                        FontSize="28"
                        BackgroundColor="Transparent"
                        TextColor="#4A90E2"
                        Clicked="OnNextMonthClicked"
                        Grid.Column="2" />

                </Grid>

            </Border>


            <!-- ========================= -->
            <!-- 残高 -->
            <!-- ========================= -->

            <Border
                BackgroundColor="#EAF4FF"
                Stroke="#BFDDF8"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                Padding="22"
                Margin="0,5,0,0">

                <VerticalStackLayout
                    Spacing="8">

                    <Label
                        Text="現在の残高"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="#4A6B88" />

                    <Label
                        x:Name="BalanceLabel"
                        Text="¥0"
                        FontSize="38"
                        FontAttributes="Bold"
                        TextColor="#2878C8" />

                    <Label
                        Text="収入 − 支出"
                        FontSize="13"
                        TextColor="#78909C" />

                </VerticalStackLayout>

            </Border>


            <!-- ========================= -->
            <!-- 収入・支出 -->
            <!-- ========================= -->

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="12">

                <!-- 収入 -->

                <Border
                    BackgroundColor="#F0FAF4"
                    Stroke="#C8E8D3"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="16">

                    <VerticalStackLayout
                        Spacing="6">

                        <Label
                            Text="収入"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="#527A61" />

                        <Label
                            Text="＋"
                            FontSize="20"
                            TextColor="#45A866" />

                        <Label
                            x:Name="IncomeLabel"
                            Text="¥0"
                            FontSize="22"
                            FontAttributes="Bold"
                            TextColor="#277A45" />

                    </VerticalStackLayout>

                </Border>


                <!-- 支出 -->

                <Border
                    BackgroundColor="#FFF6EF"
                    Stroke="#F2D6BE"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="16"
                    Grid.Column="1">

                    <VerticalStackLayout
                        Spacing="6">

                        <Label
                            Text="支出"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="#8A6852" />

                        <Label
                            Text="−"
                            FontSize="20"
                            TextColor="#E58B52" />

                        <Label
                            x:Name="ExpenseLabel"
                            Text="¥0"
                            FontSize="22"
                            FontAttributes="Bold"
                            TextColor="#C96A32" />

                    </VerticalStackLayout>

                </Border>

            </Grid>


            <!-- ========================= -->
            <!-- 予算 -->
            <!-- ========================= -->

            <Border
                BackgroundColor="White"
                Stroke="#DDE7F0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                Padding="20">

                <VerticalStackLayout
                    Spacing="12">

                    <!-- タイトル -->

                    <Grid
                        ColumnDefinitions="*,Auto">

                        <Label
                            Text="今月の予算"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#1F2937" />

                        <Label
                            Text="🎯"
                            FontSize="20"
                            Grid.Column="1" />

                    </Grid>


                    <!-- 予算 -->

                    <Grid
                        ColumnDefinitions="*,Auto">

                        <Label
                            Text="設定予算"
                            FontSize="15"
                            TextColor="#7B8794" />

                        <Label
                            x:Name="BudgetLabel"
                            Text="予算：¥0"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="#334155"
                            Grid.Column="1" />

                    </Grid>


                    <!-- 使用額 -->

                    <Grid
                        ColumnDefinitions="*,Auto">

                        <Label
                            Text="使用額"
                            FontSize="15"
                            TextColor="#7B8794" />

                        <Label
                            x:Name="BudgetUsedLabel"
                            Text="使用額：¥0"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="#334155"
                            Grid.Column="1" />

                    </Grid>


                    <!-- 残り -->

                    <Grid
                        ColumnDefinitions="*,Auto"
                        Margin="0,3,0,0">

                        <Label
                            Text="残り"
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="#334155" />

                        <Label
                            x:Name="BudgetRemainingLabel"
                            Text="残り：¥0"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="#2878C8"
                            Grid.Column="1" />

                    </Grid>


                    <!-- 予算通知 -->

                    <Border
                        x:Name="BudgetAlertBorder"
                        BackgroundColor="#FFF9E8"
                        Stroke="#F4D98A"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="12"
                        IsVisible="False"
                        Margin="0,3,0,0">

                        <Label
                            x:Name="BudgetAlertLabel"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="#8A6D1D" />

                    </Border>

                </VerticalStackLayout>

            </Border>


            <!-- ========================= -->
            <!-- メニュー -->
            <!-- ========================= -->

            <Label
                Text="メニュー"
                FontSize="21"
                FontAttributes="Bold"
                TextColor="#1F2937"
                Margin="0,8,0,0" />


            <!-- 収入・支出登録 -->

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="12">

                <Button
                    Text="＋ 収入を登録"
                    FontSize="16"
                    HeightRequest="55"
                    CornerRadius="14"
                    BackgroundColor="#5BBF7A"
                    TextColor="White"
                    Clicked="OnIncomeButtonClicked" />

                <Button
                    Text="＋ 支出を登録"
                    FontSize="16"
                    HeightRequest="55"
                    CornerRadius="14"
                    BackgroundColor="#E99A63"
                    TextColor="White"
                    Grid.Column="1"
                    Clicked="OnExpenseButtonClicked" />

            </Grid>


            <!-- 履歴 -->

            <Button
                Text="📋 収支履歴を見る"
                FontSize="16"
                HeightRequest="52"
                CornerRadius="14"
                BackgroundColor="White"
                BorderColor="#BFD3E3"
                BorderWidth="1"
                TextColor="#3B6F9E"
                Clicked="OnHistoryButtonClicked" />


            <!-- 予算 -->

            <Button
                Text="🎯 月間予算を設定"
                FontSize="16"
                HeightRequest="52"
                CornerRadius="14"
                BackgroundColor="White"
                BorderColor="#BFD3E3"
                BorderWidth="1"
                TextColor="#3B6F9E"
                Clicked="OnBudgetButtonClicked" />


            <!-- カテゴリ -->

            <Button
                Text="📊 カテゴリ別集計"
                FontSize="16"
                HeightRequest="52"
                CornerRadius="14"
                BackgroundColor="White"
                BorderColor="#BFD3E3"
                BorderWidth="1"
                TextColor="#3B6F9E"
                Clicked="OnCategorySummaryButtonClicked" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>