<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KakeiboApp.BudgetPage"
             Title="予算設定"
             BackgroundColor="#F5F9FC">

    <ScrollView>
        <VerticalStackLayout
            Padding="20,15,20,30"
            Spacing="16">

            <!-- ヘッダー -->
            <VerticalStackLayout
                Spacing="2"
                Margin="0,5,0,5">

                <Label
                    Text="月間予算を設定"
                    FontSize="30"
                    FontAttributes="Bold"
                    TextColor="#1F2937" />

                <Label
                    Text="毎月の使える予算を設定できます"
                    FontSize="14"
                    TextColor="#7B8794" />

            </VerticalStackLayout>

            <!-- 対象月 -->
            <Border
                BackgroundColor="#FFFFFF"
                Stroke="#DDE7F0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                Padding="20">

                <VerticalStackLayout
                    Spacing="8">

                    <Label
                        Text="設定する月"
                        FontSize="15"
                        FontAttributes="Bold"
                        TextColor="#7B8794" />

                    <Label
                        x:Name="MonthLabel"
                        Text="2026年9月の予算"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="#5B8DB8" />

                </VerticalStackLayout>

            </Border>

            <!-- 予算入力 -->
            <Border
                BackgroundColor="#FFFFFF"
                Stroke="#DDE7F0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                Padding="20">

                <VerticalStackLayout
                    Spacing="12">

                    <Label
                        Text="予算金額"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="#334155" />

                    <Entry
                        x:Name="BudgetEntry"
                        Placeholder="例：30,000"
                        Keyboard="Numeric"
                        FontSize="22"
                        HeightRequest="55"
                        TextColor="#1F2937"
                        PlaceholderColor="#A0AAB4" />

                    <Label
                        Text="この金額を今月の予算として設定します"
                        FontSize="13"
                        TextColor="#7B8794" />

                </VerticalStackLayout>

            </Border>

            <!-- 保存ボタン -->
            <Button
                Text="✓ 予算を保存"
                FontSize="17"
                FontAttributes="Bold"
                HeightRequest="56"
                CornerRadius="14"
                BackgroundColor="#7DB7E8"
                TextColor="White"
                Margin="0,4,0,0"
                Clicked="OnSaveClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>